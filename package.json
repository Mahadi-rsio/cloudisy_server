{
  "name": "pagex",
  "version": "1.0.0",
  "description": "PageX - Multi-tenant static site hosting platform",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm run dev:api & pnpm run dev:blob-server & pnpm run dev:console",
    "dev:api": "cd services/api && pnpm run dev",
    "dev:blob-server": "cd services/blob-server && go run .",
    "dev:console": "cd services/console && pnpm run dev",
    "build": "pnpm run build:api && pnpm run build:blob-server && pnpm run build:console",
    "build:api": "cd services/api && pnpm run build",
    "build:blob-server": "cd services/blob-server && go build -o caddy .",
    "build:console": "cd services/console && pnpm run build",
    "lint": "pnpm run lint:api && pnpm run lint:console",
    "lint:api": "cd services/api && pnpm run lint",
    "lint:console": "cd services/console && pnpm run lint",
    "test": "pnpm run test:api && pnpm run test:console",
    "test:api": "cd services/api && pnpm run test",
    "test:console": "cd services/console && pnpm run test",
    "db:generate": "cd services/api && pnpm run db:generate",
    "db:migrate": "cd services/api && pnpm run db:migrate",
    "db:push": "cd services/api && pnpm run db:push",
    "db:studio": "cd services/api && pnpm run db:studio",
    "docker": "bash scripts/docker.sh",
    "docker:up": "bash scripts/docker.sh up",
    "docker:down": "bash scripts/docker.sh down",
    "docker:build": "bash scripts/docker.sh build",
    "docker:rebuild": "bash scripts/docker.sh rebuild",
    "docker:restart": "bash scripts/docker.sh restart",
    "docker:ps": "bash scripts/docker.sh ps",
    "docker:logs": "bash scripts/docker.sh logs",
    "docker:exec": "bash scripts/docker.sh exec",
    "docker:migrate": "bash scripts/docker.sh migrate",
    "docker:console": "bash scripts/docker.sh console",
    "docker:api": "bash scripts/docker.sh api",
    "docker:workers": "bash scripts/docker.sh workers",
    "docker:config": "bash scripts/docker.sh config",
    "clean": "rm -rf node_modules dist .next pnpm-lock.yaml",
    "clean:all": "rm -rf node_modules services/*/node_modules services/*/dist services/*/.next pnpm-lock.yaml"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "pagex",
    "static-site",
    "hosting",
    "multi-tenant",
    "monorepo",
    "docker"
  ],
  "author": "",
  "license": "MIT"
}